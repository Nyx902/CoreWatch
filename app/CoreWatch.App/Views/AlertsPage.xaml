<Page
    x:Class="CoreWatch.App.AlertsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="20">
            <StackPanel Spacing="2">
                <TextBlock Text="Temperature Alerts" FontSize="24" FontWeight="SemiBold" />
                <TextBlock Text="Configure threshold notifications for supported thermal sensors" Style="{StaticResource SubtleCaptionStyle}" />
            </StackPanel>

            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="16">
                    <ToggleSwitch x:Name="AlertsEnabledToggle" Header="Enable temperature threshold alerts" Toggled="OnAlertSettingChanged" />

                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <NumberBox x:Name="GpuThresholdBox" Grid.Column="0" Header="GPU Threshold (°C)"
                                   Minimum="30" Maximum="115" SpinButtonPlacementMode="Inline"
                                   ValueChanged="OnNumberChanged" />

                        <NumberBox x:Name="CpuThresholdBox" Grid.Column="1" Header="CPU Threshold (°C, if supported)"
                                   Minimum="30" Maximum="115" SpinButtonPlacementMode="Inline"
                                   ValueChanged="OnNumberChanged" />

                        <NumberBox x:Name="CooldownBox" Grid.Column="2" Header="Alert Cooldown (seconds)"
                                   Minimum="5" Maximum="3600" SpinButtonPlacementMode="Inline"
                                   ValueChanged="OnNumberChanged" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Text="Recent Alert Events" FontSize="15" FontWeight="SemiBold" />
                    <TextBlock x:Name="EmptyAlertsText" Text="No temperature alerts triggered in this session." Style="{StaticResource SubtleCaptionStyle}" />
                    <StackPanel x:Name="AlertsListPanel" Spacing="8" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
